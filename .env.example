# Guest rooms work without an account; username sign-in requires the secret below.
# Copy to .env.local and generate a unique server-only secret for this installation.
DATABASE_URL=file:./.data/pavilion.db

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# On Vercel, configure a separate production secret and your public HTTPS URL.
# Keep the secret stable: account sessions and encrypted room recovery use it.

# For a hosted deployment, use a persistent libSQL/Turso database:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-database-token
# Vercel's Turso Marketplace integration supplies these aliases automatically:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token
# Remove the local DATABASE_URL override above when using the TURSO_* aliases.
# Never expose either authentication token using a NEXT_PUBLIC_ variable.

# Vercel uses managed, on-demand cloud refreshes by default. Local development
# defaults to direct source requests. The cloud uses Vercel project OIDC; no
# desktop process, browser extension, Google credential or worker secret is needed.
# PAVILION_SEASON_FETCH_MODE=cloud
# Legacy developer-only worker mode must be selected explicitly with "worker".
# Never prefix its optional secret with NEXT_PUBLIC_.
# PAVILION_SOURCE_WORKER_TOKEN=
# Worker process only: the public website origin (no path).
# PAVILION_WORKER_ORIGIN=https://your-pavilion-site.vercel.app
