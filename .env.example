# Optional: localhost works without this file or any account.
# Copy to .env.local only when you want to override the defaults.
DATABASE_URL=file:./.data/pavilion.db

# For a future Vercel deployment, use a persistent hosted libSQL/Turso database:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-database-token
# Never expose DATABASE_AUTH_TOKEN using a NEXT_PUBLIC_ variable.
