{
  "name": "pavilion-auction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "npm run build && npm run start",
    "test": "node --experimental-strip-types --test tests/auction.test.ts tests/auction-client.test.ts tests/auction-client-options.test.ts tests/player-catalog.test.ts tests/player-lookup.test.ts tests/auction-audio.test.ts tests/pool-upgrade.test.ts tests/practice-session.test.ts tests/shared-player-catalog.test.ts tests/database-write-queue.test.ts tests/request-origin.test.ts tests/room-poll-cache.test.ts tests/room-creation.test.ts tests/database-native-lock.test.ts tests/teams.test.ts tests/room-access.test.ts tests/lineup.test.ts tests/auction-interactions.test.ts tests/lot-notifications.test.ts tests/player-roles.test.ts tests/room-navigation.test.ts tests/database-config.test.mjs tests/target-picks.test.ts tests/unlock.test.ts tests/auction-completion.test.ts tests/squad-comparison.test.ts tests/auction-exports.test.ts",
    "test:api": "node tests/run-isolated-api.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:init": "node --env-file-if-exists=.env.local scripts/init-db.mjs",
    "db:import-local-d1": "node --env-file-if-exists=.env.local scripts/import-local-d1.mjs",
    "db:sync-catalog": "node --experimental-strip-types scripts/sync-player-catalog.ts",
    "players:enrich": "node --experimental-strip-types scripts/enrich-player-catalog.mjs",
    "players:cache-images": "node scripts/cache-player-portraits.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@libsql/client": "^0.18.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfkit": "0.20.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
